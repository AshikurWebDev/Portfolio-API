# Copy to deploy/.env on the server and fill in. Never commit or share .env.

# Where the frontend repository is cloned, relative to this deploy/ folder.
WEB_DIR=../../portfolio-web

# Your domain, no https:// and no trailing slash, e.g. ashikur.dev
# Its DNS A record must point at the VPS IP before the first start (Caddy needs it for HTTPS).
DOMAIN=example.com

# Database password. Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT signing key, at least 32 characters. Generate one:  openssl rand -base64 48
JWT_SIGNING_KEY=

# Google OAuth client id (same one as in web/.env). In Google Cloud Console add
# https://<DOMAIN> to the client's "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# The Gmail address allowed to sign in to /admin.
ADMIN_EMAIL=
